# NodeLab 백엔드 엔진 설정 예시 (원본: ZelinZhou-THU/stem-tutor-agent)
# 이 파일을 key.env 로 복사해 실제 값을 넣으세요.
# 런타임 모델은 NodeLab 확정 스택만 사용한다 (docs/adr/ADR-019).
#   - Gemini 3.7 Flash : OCR · CAT 진단 · 변형 블라인드 재풀이
#   - DeepSeek V4 Flash: 변형 생성 · 힌트 (지금은 OpenCode Zen 무료 모델로 대체 가능)
#   - SymPy            : 결정론 검산 (로컬, 키 불필요)

# === 기본 ===
STEM_TUTOR_PROVIDER=openai-compatible
STEM_TUTOR_SUBJECT=calculus

# === API (OpenAI 호환 게이트웨이) ===
# Gemini OpenAI 호환: https://generativelanguage.googleapis.com/v1beta/openai
# DeepSeek V4 Flash: https://opencode.ai/zen/v1 (OpenCode Zen) 또는 https://api.deepseek.com
PARATERA_API_KEY=your-api-key-here
PARATERA_URL=https://opencode.ai/zen/v1

# === 모델 (NodeLab 확정 스택 — 바꾸지 마시오) ===
STEM_TUTOR_REASONING_MODEL=gemini-3.7-flash
STEM_TUTOR_FAST_MODEL=deepseek-v4-flash
STEM_TUTOR_OCR_MODEL=gemini-3.7-flash
STEM_TUTOR_DETECTION_MODEL=gemini-3.7-flash
# 무료 검증 기간에만 임시 대체 (env로만 교체, 코드 수정 금지):
# STEM_TUTOR_FAST_MODEL=glm-5-free

# === 분석 깊이 ===
STEM_TUTOR_DEPTH=with_ref

# === 기능 스위치 ===
STEM_TUTOR_SYMPY_ENABLED=true
STEM_TUTOR_TOOL_CALLING=false
STEM_TUTOR_DUAL_MODEL=false
STEM_TUTOR_SIMPLE_FASTPATH=true
STEM_TUTOR_DETERMINISTIC_VERIFY=true

# === JWT (운영은 랜덤 생성) ===
# python -c "import secrets; print(secrets.token_urlsafe(64))"
STEM_TUTOR_JWT_SECRET=change-me-to-a-random-secret

# === 타임아웃/재시도 ===
STEM_TUTOR_TIMEOUT=300
STEM_TUTOR_MAX_RETRIES=1
STEM_TUTOR_ALLOW_MOCK_FALLBACK=true
